#!/usr/bin/env bash
# shellcheck disable=SC2086
# Displays the DNS record type and destination for one or more subdomains
# Usage: ./0-world_wide_web <domain> [subdomain]

domain=$1
subdomain=$2

# Prints "The subdomain X is a TYPE record and points to DEST" for a subdomain
display_subdomain_info() {
    sub=$1
    result=$(dig $sub.$domain | awk '/^;; ANSWER SECTION:/{getline; print $4, $5}')
    read -r type dest <<< "$result"
    echo "The subdomain $sub is a $type record and points to $dest"
}

if [ -n "$subdomain" ]; then
    display_subdomain_info "$subdomain"
else
    for s in www lb-01 web-01 web-02; do
        display_subdomain_info "$s"
    done
fi
