#!/usr/bin/env bash
# 0-world_wide_web - displays DNS record info for subdomains of a domain

domain=$1
subdomain=$2

print_subdomain_info() {
    local sub=$1
    local dom=$2
    local host="${sub}.${dom}"
    local result

    result=$(dig "$host" | awk '
        /^;; ANSWER SECTION:/ { found=1; next }
        found && NF >= 4 { print $4, $5; exit }
    ')

    local record_type destination
    record_type=$(echo "$result" | awk '{print $1}')
    destination=$(echo "$result" | awk '{print $2}')

    echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
}

if [ -n "$subdomain" ]; then
    print_subdomain_info "$subdomain" "$domain"
else
    for sub in www lb-01 web-01 web-02; do
        print_subdomain_info "$sub" "$domain"
    done
fi
